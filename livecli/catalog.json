  {
   "match": "Align Delay|IR Measurement",
   "category": "utility",
   "styles": [
    "alignment",
    "measurement"
   ],
   "notes": "Align Delay: delay a track by ms/samples/distance (phase and timing alignment)"
  },
  {
   "match": "LA-2A|CLA-2A",
